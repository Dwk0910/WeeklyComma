{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://weeklycomma.tail2f41fe.ts.net/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "proxy": {
        "entrypoint": "proxy.ts",
        "matcher": ["/api/authsessions/:path*", "/api/users/:path*"]
    },
    "headers": [
        {
            "source": "/api/:path*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store"
                }
            ]
        }
    ]
}
